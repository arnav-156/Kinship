{
  "name": "@relationship/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rimraf .next tsconfig.tsbuildinfo",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:quality": "next dev --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run --passWithNoTests",
    "test:quality": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@relationship/shared": "workspace:*",
    "lucide-react": "^1.24.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17"
  }
}
