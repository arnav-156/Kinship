NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=7000
API_CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WEB_PORT=3000
WORKER_CONCURRENCY=2
WORKER_LEASE_MS=30000
WORKER_POLL_INTERVAL_MS=1000

DATABASE_URL=postgresql://relationship:relationship@localhost:5432/relationship
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-local-development-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
SCHEDULER_INTERVAL_MS=300000
S3_BUCKET=relationship-local
S3_FORCE_PATH_STYLE=true

AI_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional one-attempt production fallback (provider and API key are required together;
# endpoint and model values are optional overrides):
# AI_FALLBACK_PROVIDER=openai-compatible
# AI_FALLBACK_BASE_URL=https://secondary-provider.example.com/v1
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_CHAT_MODEL=secondary-chat-model
# AI_FALLBACK_EMBEDDING_MODEL=secondary-embedding-model

# Base64-encoded 32-byte key used only by the connector-token administrative utility.
CONNECTOR_TOKEN_ENCRYPTION_KEY=
CONNECTOR_TOKEN_OPERATOR=
